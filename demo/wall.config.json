{
  "title": "Keret demo wall",
  "description": "A hundred public-domain photographs, each with its camera data, on a wall you can pan and zoom",
  "lang": "en",
  "siteUrl": "https://krisztianhadi.github.io/keret/",
  "themeColor": "#26231e",
  "font": "mono",
  "photosDir": "photos",
  "outDir": "dist",
  "captions": {
    "file": "captions.json",
    "maxLines": 2,
    "showYear": true,
    "showCamera": true,
    "showSpecs": true
  },
  "images": {
    "maxEdge": 1000,
    "quality": 74
  },
  "noscript": {
    "limit": 60
  }
}
